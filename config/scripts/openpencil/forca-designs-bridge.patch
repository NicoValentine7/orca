@@ -0,0 +1,51 @@
+/*
+ * Inside forca's Designs panel the interface takes forca's tokens (`--orca-*`, sent by the panel)
+ * so it reads as part of forca. `!important` beats the accent palette OpenPencil writes inline.
+ */
+html[data-forca] {
+  --color-panel: var(--orca-sidebar) !important;
+  --color-panel-secondary: var(--orca-sidebar) !important;
+  --color-panel-field: var(--orca-muted) !important;
+  --color-panel-field-hover: var(--orca-accent) !important;
+  --color-panel-focus: var(--orca-ring) !important;
+  --color-panel-selected: var(--orca-accent) !important;
+  --color-panel-selected-muted: color-mix(
+    in srgb,
+    var(--orca-foreground) 10%,
+    var(--orca-sidebar)
+  ) !important;
+  --color-canvas: var(--orca-editor-surface) !important;
+  --color-border: var(--orca-border) !important;
+  --color-hover: var(--orca-accent) !important;
+  --color-accent: var(--orca-primary) !important;
+  --color-on-accent: var(--orca-primary-foreground) !important;
+  --color-surface: var(--orca-foreground) !important;
+  --color-muted: var(--orca-muted-foreground) !important;
+  --color-input: var(--orca-background) !important;
+  --color-error: var(--orca-destructive) !important;
+  --color-error-fill: var(--orca-destructive) !important;
+  --color-ruler-bg: var(--orca-sidebar) !important;
+  --color-ruler-tick: var(--orca-ring) !important;
+  --color-ruler-text: var(--orca-muted-foreground) !important;
+  --font-sans: var(--orca-font-sans) !important;
+  --font-mono: var(--orca-font-mono) !important;
+  --default-font-family: var(--orca-font-sans) !important;
+  --radius-sm: calc(var(--orca-radius) * 0.6) !important;
+  --radius-md: calc(var(--orca-radius) * 0.8) !important;
+  --radius-lg: var(--orca-radius) !important;
+  --radius-xl: calc(var(--orca-radius) * 1.4) !important;
+}
+
+html[data-forca] body {
+  font-family: var(--orca-font-sans);
+}
+
+/* forca shows the file's name and the way back, and has no rooms or sharing here. */
+html[data-forca='file'] [data-slot='tab-bar'],
+html[data-forca] [data-test-id='collab-share-button'],
+html[data-forca] [data-test-id='collab-avatars'],
+html[data-forca] [data-test-id='mobile-share'],
+html[data-forca] [data-test-id='mobile-presence'],
+html[data-forca] [data-test-id='home-join-room'] {
+  display: none !important;
+}
diff --git a/src/app/forca/host.ts b/src/app/forca/host.ts
new file mode 100644
index 0000000..5dbc6d6
--- /dev/null
+++ b/src/app/forca/host.ts
@@ -0,0 +1,61 @@
+import { updateAISetupState } from '@/app/settings/preferences/store'
+import { setAppTheme } from '@/app/shell/theme'
+
+import './host.css'
+
+/** forca's theme as its Designs panel sends it: the color scheme and its own `--orca-*` tokens. */
+export interface ForcaTheme {
+  colorScheme: 'light' | 'dark'
+  tokens: string
+}
+
+/** What forca's Designs panel exposes to this page through its preload. */
+export interface ForcaHost {
+  /** The designs/ file the panel opened, or null when the panel shows OpenPencil's own home. */
+  open(): Promise<{ name: string; bytes: Uint8Array } | null>
+  write(bytes: Uint8Array): Promise<void>
+  theme(): ForcaTheme | null
+  onTheme(listener: (theme: ForcaTheme) => void): void
+  /** forca calls this before it removes the page, so the last edit is written first. */
+  onFlush(handler: () => Promise<void>): void
+}
+
+const FORCA_INTERFACE_FONT = { family: 'Geist', url: '/forca/Geist-Variable.woff2' }
+
+export function forcaHost(): ForcaHost | null {
+  const host = (globalThis as { forcaDesigns?: Partial<ForcaHost> }).forcaDesigns
+  return host?.open && host.write && host.theme && host.onTheme && host.onFlush
+    ? (host as ForcaHost)
+    : null
+}
+
+function applyForcaTheme(theme: ForcaTheme): void {
+  let style = document.getElementById('forca-tokens')
+  if (!style) {
+    style = document.createElement('style')
+    style.id = 'forca-tokens'
+    document.head.append(style)
+  }
+  // forca strips {}<>; from each value, so the tokens cannot close this rule.
+  style.textContent = `:root{${theme.tokens}}`
+  setAppTheme(theme.colorScheme)
+}
+
+/**
+ * Runs before the app mounts inside forca's Designs panel: forca's tokens restyle the interface,
+ * its theme replaces OpenPencil's, and the first-run welcome stays closed.
+ */
+export function prepareForcaHost(host: ForcaHost): void {
+  // The panel names the mode in the address, since the file itself arrives only after mount.
+  const mode = new URL(location.href).searchParams.get('forca') === 'file' ? 'file' : 'home'
+  document.documentElement.dataset.forca = mode
+  updateAISetupState('done')
+  document.fonts.add(
+    new FontFace(FORCA_INTERFACE_FONT.family, `url(${FORCA_INTERFACE_FONT.url})`, {
+      weight: '100 900'
+    })
+  )
+  const theme = host.theme()
+  if (theme) applyForcaTheme(theme)
+  host.onTheme(applyForcaTheme)
+}
