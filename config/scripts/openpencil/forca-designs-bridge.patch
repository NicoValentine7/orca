+++ b/src/app/forca/designs-bridge.ts
@@ -0,0 +1,90 @@
+import { watch } from 'vue'
+
+import type { EditorStore } from '@/app/editor/session'
+import type { ForcaHost } from '@/app/forca/host'
+import { openFileInNewTab } from '@/app/tabs/open/file'
+import { createDocumentTab } from '@/app/tabs/state'
+
+const AUTOSYNC_DELAY_MS = 600
+
+function concat(chunks: Uint8Array[]): Uint8Array {
+  const out = new Uint8Array(chunks.reduce((size, chunk) => size + chunk.byteLength, 0))
+  let offset = 0
+  for (const chunk of chunks) {
+    out.set(chunk, offset)
+    offset += chunk.byteLength
+  }
+  return out
+}
+
+/**
+ * Opens the designs/ file forca handed over and writes each save back to it through a file
+ * handle, so OpenPencil's own save path is the only writer.
+ */
+export async function startForcaDesignsBridge(host: ForcaHost): Promise<void> {
+  const opened = await host.open()
+  if (!opened) return
+  const { name } = opened
+  let current = opened.bytes
+  let modified = Date.now()
+
+  const handle = {
+    kind: 'file' as const,
+    name,
+    getFile: async () => new File([current.slice()], name, { lastModified: modified }),
+    isSameEntry: async (other: unknown) => other === handle,
+    queryPermission: async () => 'granted' as const,
+    requestPermission: async () => 'granted' as const,
+    createWritable: async () => {
+      const chunks: Uint8Array[] = []
+      return new WritableStream<Uint8Array | ArrayBuffer>({
+        write(chunk) {
+          chunks.push(chunk instanceof Uint8Array ? chunk.slice() : new Uint8Array(chunk))
+        },
+        async close() {
+          current = concat(chunks)
+          modified = Date.now()
+          await host.write(current)
+        }
+      })
+    }
+  } as unknown as FileSystemFileHandle
+
+  let store: EditorStore
+  if (current.byteLength > 0) {
+    store = await openFileInNewTab(new File([current.slice()], name), { handle })
+  } else {
+    store = createDocumentTab('design').store
+    store.setDocumentSource(name, 'fig', handle)
+  }
+
+  let timer: ReturnType<typeof setTimeout> | undefined
+  let writing: Promise<void> = Promise.resolve()
+  const writeNow = (): Promise<void> => {
+    clearTimeout(timer)
+    timer = undefined
+    // One write at a time; a flush waits for the one in flight, then writes what is left.
+    writing = writing.then(async () => {
+      if (!store.hasUnsavedChanges()) return
+      await store
+        .saveFigFile()
+        .catch((error: unknown) => console.error('[forca] design write failed', error))
+    })
+    return writing
+  }
+  const schedule = () => {
+    clearTimeout(timer)
+    timer = setTimeout(() => {
+      void writeNow().then(() => {
+        if (store.hasUnsavedChanges()) schedule()
+      })
+    }, AUTOSYNC_DELAY_MS)
+  }
+  watch(
+    () => store.hasUnsavedChanges(),
+    (dirty) => {
+      if (dirty) schedule()
+    }
+  )
+  host.onFlush(writeNow)
+}
diff --git a/src/app/forca/host.css b/src/app/forca/host.css
